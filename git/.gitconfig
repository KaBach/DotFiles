# This is Git's per-user configuration file.
[user]
	name = Karsten Bach
	email = karsten_bach@hotmail.com
[alias]
        graph = log --graph --oneline --all --simplify-by-decoration
[credential]
	helper = cache
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
